{
  "name": "chesslab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "verify:exercises": "node scripts/verify-exercises.mjs",
    "postinstall": "node scripts/copy-stockfish.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
