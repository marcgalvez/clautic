{
  "name": "clautic-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:api": "node dev/local-api.mjs",
    "db:reset": "bash dev/reset_db.sh",
    "db:test": "psql -U postgres -h localhost -d clautic -f dev/test.sql",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc -b && vite build --mode demo"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@supabase/supabase-js": "^2.46.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
