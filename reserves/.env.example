# ───────── Base ─────────
# PostgreSQL 14+ amb l'extensió btree_gist disponible (la migració inicial la crea)
DATABASE_URL="postgresql://usuari:contrasenya@localhost:5432/reserves?schema=public"
# URL pública exacta (sense barra final). En producció ha de ser HTTPS.
APP_URL="http://localhost:3000"
APP_NAME="Reserves"
# 32 bytes en base64 → openssl rand -base64 32   (xifra tokens de Google i enllaços de gestió)
# ⚠ Si es perd o es canvia, els tokens guardats deixen de funcionar.
ENCRYPTION_KEY=""
# Protegeix /api/cron/tick → openssl rand -hex 24
CRON_SECRET=""

# ───────── Google Calendar (OAuth 2.0) ─────────
# Google Cloud Console → APIs i serveis → Credencials → ID de client OAuth (aplicació web)
# URI de redirecció autoritzada: ${APP_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── WhatsApp Business Platform (Meta Cloud API) ─────────
# meta_cloud = enviament real · log = només registre (prohibit en producció) · none = desactivat
WHATSAPP_PROVIDER="none"
# Token d'usuari del sistema (Business Manager) amb permís whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_DISPLAY_PHONE=""
# Secret de l'app de Meta (verifica X-Hub-Signature-256 dels webhooks)
WHATSAPP_APP_SECRET=""
# Cadena que tu tries i poses també a Meta en configurar el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_TEMPLATE_REMINDER="recordatori_cita"
WHATSAPP_GRAPH_VERSION="v23.0"

# ───────── Treballador ─────────
WORKER_INTERVAL_MS="30000"
